<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ============================================================
      Zentwik 应用图标（矢量，可复用）
      ============================================================

      【来源】
      Assets/icons/Zentwik.svg —— 由位图描摹（VTracer 0.6.4）生成，
      原始路径 60KB / 7051 个绘图命令，直接放进 XAML 不可接受
      （XAML 编译慢、运行时几何体臃肿）。

      【处理】
      用 Ramer-Douglas-Peucker 算法简化到 48 个点，
      容差 0.25 目标像素。已渲染与原 PNG 逐像素比对，形状完全一致。
      坐标归一化到 32×32 视区 —— Stretch 到任意尺寸都清晰无损。

      【配色】
      原 SVG 是灰阶（#000000 / #7F7F7F / #C3C3C3），
      这里换成品牌色系三层（主色 / 中间调 / 高光），
      跟随强调色变化，深浅两套主题下都协调。

      【实现】
      用 GeometryMask + 三层 GeometryDrawing：
        · 蒙版 = 全部 6 条路径的并集（决定图标的**轮廓**）
        · 底层 = 主色铺满蒙版区域
        · 中间层 / 高光层 = 原 SVG 的第 2、3 组路径
      这样三层共享同一轮廓，不会出现方块或溢出。
    -->

    <!-- 图标轮廓：6 条路径的并集，作为 GeometryMask -->
    <GeometryGroup x:Key="BrandLogoMask">
        <PathGeometry Figures="M0,0 L23.9,8.2 L22.1,12.6 L11.8,19.5 L22.1,26.2 L22.1,32 L0,24.8 L0,19.5 L6,16.3 L8.3,9.7 L0,6.7 L13.8,11.5 L13.6,12.1 L14.4,11.7 L13.9,11.5 Z" />
        <PathGeometry Figures="M1.2,2.2 L22.1,9.4 L21.1,12 L11.6,18.2 L13.2,13.6 L18,11 L18.2,10.4 L17.4,10 L15.6,11 L1.3,6 L1.2,2.2 Z" />
        <PathGeometry Figures="M11.7,19.5 L20.9,25.5 L20.9,30 L8.2,22.2 L8,22 L11.7,19.5 Z" />
        <PathGeometry Figures="M5.2,18.1 L3.8,22.5 L9.3,24.3 L17.1,29.1 L1.2,23.7 L1.2,20.2 L5.2,18.1 Z" />
        <PathGeometry Figures="M8.3,9.6 L13.8,11.5 L13.5,12.2 L6,16.3 L8.3,9.7 Z" />
        <PathGeometry Figures="M1.2,24.6 L20.9,31.3 L20.7,31.7 L1.2,25.1 Z" />
    </GeometryGroup>

    <DrawingBrush x:Key="BrandLogoBrush"
                   Viewbox="0 0 32 32"
                   ViewboxUnits="Absolute"
                   Stretch="Uniform"
                   TileMode="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!--
                    底层：主色铺满整个 32×32，
                    由 GeometryMask 裁出图标轮廓。
                -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentBrush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,32,32" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 中间调（原 SVG 的第 2 组深灰） -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentMidBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1.2,2.2 L22.1,9.4 L21.1,12 L11.6,18.2 L13.2,13.6 L18,11 L18.2,10.4 L17.4,10 L15.6,11 L1.3,6 L1.2,2.2 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 高光（原 SVG 的第 3 组浅灰） -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentLightBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M11.7,19.5 L20.9,25.5 L20.9,30 L8.2,22.2 L8,22 L11.7,19.5 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 第二组中间调（原 SVG 的第 4 组深灰） -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentMidBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M5.2,18.1 L3.8,22.5 L9.3,24.3 L17.1,29.1 L1.2,23.7 L1.2,20.2 L5.2,18.1 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 第二组高光 -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentLightBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M8.3,9.6 L13.8,11.5 L13.5,12.2 L6,16.3 L8.3,9.7 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!-- 第三组高光 -->
                <GeometryDrawing Brush="{DynamicResource BrandAccentLightBrush}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M1.2,24.6 L20.9,31.3 L20.7,31.7 L1.2,25.1 Z" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!--
        几何蒙版画刷：只保留图标轮廓，丢弃中间层次。
        用于需要单色图标（如托盘图标、窗口标题）的场景。
    -->
    <DrawingBrush x:Key="BrandLogoMaskBrush"
                   Viewbox="0 0 32 32"
                   ViewboxUnits="Absolute"
                   Stretch="Uniform"
                   TileMode="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Brush>
                    <SolidColorBrush Color="White" />
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <PathGeometry Figures="M0,0 L23.9,8.2 L22.1,12.6 L11.8,19.5 L22.1,26.2 L22.1,32 L0,24.8 L0,19.5 L6,16.3 L8.3,9.7 L0,6.7 L13.8,11.5 L13.6,12.1 L14.4,11.7 L13.9,11.5 Z" />
                        <PathGeometry Figures="M1.2,2.2 L22.1,9.4 L21.1,12 L11.6,18.2 L13.2,13.6 L18,11 L18.2,10.4 L17.4,10 L15.6,11 L1.3,6 L1.2,2.2 Z" />
                        <PathGeometry Figures="M11.7,19.5 L20.9,25.5 L20.9,30 L8.2,22.2 L8,22 L11.7,19.5 Z" />
                        <PathGeometry Figures="M5.2,18.1 L3.8,22.5 L9.3,24.3 L17.1,29.1 L1.2,23.7 L1.2,20.2 L5.2,18.1 Z" />
                        <PathGeometry Figures="M8.3,9.6 L13.8,11.5 L13.5,12.2 L6,16.3 L8.3,9.7 Z" />
                        <PathGeometry Figures="M1.2,24.6 L20.9,31.3 L20.7,31.7 L1.2,25.1 Z" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
