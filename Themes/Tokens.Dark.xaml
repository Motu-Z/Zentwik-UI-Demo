<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      深色主题令牌 —— 严格对齐参考 HTML 的 [data-theme="dark"]。

      【键集合契约】
      本文件与 Tokens.Light.xaml 的键集合必须完全一致。
      主题切换是「整份字典按 key 覆盖」，少一个键就会在切到浅色时
      静默退化成「找不到资源 → 透明 / 默认黑」，这种 bug 在深色下看不出来。

      【强调色不在这里】
      强调色由 Accent.xaml 单独持有并原地改色（SolidColorBrush.Color setter），
      切换用户选中的强调色时中性色与语义色一个字节都不动 ——
      否则用户的品牌色会连带把「危险=红」也染掉，语义就废了。
    -->

    <!-- ============ 窗口 / 侧栏 ============ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF1C1C1C" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FF202020" />

    <!-- ============ 边框 ============ -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FF383838" />

    <!-- ============ 卡片 ============ -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF232323" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="#FF1A1A1A" />

    <!-- ============ 文本 ============ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="TextMetaBrush" Color="#FF6B6B6B" />

    <!-- ============ 导航项 ============ -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#1AFFFFFF" />

    <!-- ============ 控件表面 ============ -->
    <SolidColorBrush x:Key="ControlBgBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF3A3A3A" />

    <!-- ============ 语义色（固定，不随强调色变）============ -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
      注释行专用字体链。

      【为什么不能直接用 AppMonoFontFamily】
      Cascadia Mono / Consolas / Courier New 全都没有中文字形。
      WPF 遇到缺字时会回退到「全局字体回退」—— 在中文 Windows 上
      那就是宋体（SimSun，衬线），于是「// 关上我身后的门，我走了。」
      会变成「等宽斜杠 + 宋体正文」，两种字形基线、笔画风格完全割裂，
      看起来就像渲染出错。

      【解法】
      把中文字体显式放进字体链：WPF 的 FontFamily 支持逗号分隔的
      回退列表，逐字符从前往后找第一个能提供该字形的字体。
      于是 ASCII（//、ZMotu）仍由 Cascadia Mono 渲染（等宽、锐利），
      中文落到 Microsoft YaHei UI（无衬线），两者风格统一。
    -->
    <FontFamily x:Key="AppCommentFontFamily">Cascadia Mono, Microsoft YaHei UI, Microsoft YaHei, DengXian</FontFamily>

    <!--
      ============ 卡片阴影 ============
      放在主题令牌里而不是控件样式里 —— 深色下需要更重的阴影才有层次，
      浅色下同样的参数会显得脏。Effect 必须是深浅两套各一份。
    -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="16" ShadowDepth="2" Direction="270"
                      Color="Black" Opacity="0.45" RenderingBias="Quality" />

</ResourceDictionary>
