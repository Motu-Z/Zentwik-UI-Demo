<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      浅色主题令牌 —— 严格对齐参考 HTML 的 [data-theme="light"]。

      【键集合契约】
      与 Tokens.Dark.xaml 的键集合必须完全一致，缺一个键就会在切到浅色时
      静默退化成「找不到资源 → 透明 / 默认黑」。
    -->

    <!-- ============ 窗口 / 侧栏 ============ -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FFEAEAEA" />

    <!-- ============ 边框 ============ -->
    <SolidColorBrush x:Key="BorderColorBrush" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#FFD0D0D0" />

    <!-- ============ 卡片 ============ -->
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardInnerBgBrush" Color="#FFF3F3F3" />

    <!-- ============ 文本 ============ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5D5D5D" />
    <SolidColorBrush x:Key="TextMetaBrush" Color="#FF8A8A8A" />

    <!-- ============ 导航项 ============ -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#FFDFDFDF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#FFD0D0D0" />

    <!-- ============ 控件表面 ============ -->
    <SolidColorBrush x:Key="ControlBgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FFD6D6D6" />

    <!-- ============ 语义色（固定，不随强调色变）============ -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE81123" />

    <!-- ============ 字体 ============ -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!--
      注释行专用字体链 —— 与 Tokens.Dark.xaml 严格一致。
      关键点：把中文字体显式放进链条，避免中文回退到宋体（衬线）
      与等宽的「//」割裂。详见 Tokens.Dark.xaml 中的说明。
    -->
    <FontFamily x:Key="AppCommentFontFamily">Cascadia Mono, Microsoft YaHei UI, Microsoft YaHei, DengXian</FontFamily>

    <!--
      ============ 卡片阴影 ============
      浅色下阴影要轻得多，否则白卡片在浅灰底上像贴了张黑纸。
      键集合与 Tokens.Dark.xaml 严格一致。
    -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      BlurRadius="14" ShadowDepth="1" Direction="270"
                      Color="Black" Opacity="0.10" RenderingBias="Quality" />

</ResourceDictionary>
