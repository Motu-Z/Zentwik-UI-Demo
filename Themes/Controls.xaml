<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore">

    <!--
      通用控件样式。

      【颜色一律用 DynamicResource】
      主题切换时换的是资源字典，StaticResource 在加载时已解析固定，
      切主题后不会跟着变。全局默认样式里必须用 DynamicResource。

      ============================================================
      关于「虚线焦点框」——本文件里最重要的一件事
      ============================================================

      WPF 的默认焦点视觉是系统主题绘制的一圈**点划线**矩形，
      样式形如：

        <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
          <Setter Property="Control.Template">
            <Setter.Value>
              <ControlTemplate>
                <Rectangle StrokeDashArray="1 2" ... />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>

      【为什么 FocusVisualStyle="{x:Null}" 解决不了】
      x:Null 表示「没有自定义焦点视觉」—— WPF 会**回退到系统默认**，
      虚线照旧出现。实测：设成 null 后控件的 FocusVisualStyle
      仍然解析到 TargetType=IFrameworkInputElement 的系统样式。
      要真正消掉虚线，必须给一个**空模板**的 Style。

      【本文件的做法】
      两种焦点样式，按控件用途选用：
        · NoFocusVisual     —— 空模板，完全不画任何焦点框
                                （输入框、滚动条这类自带选中指示的控件）
        · KeyboardFocusRing —— 自绘**实线**强调色圆角框
                                （导航项、分段控件）
      两者都覆盖掉系统默认的虚线，且因为走 FocusVisualStyle 机制，
      WPF 只在**键盘导航**时显示它 —— 鼠标点击不会出现，
      符合 Windows 惯例。

      【兜底】
      Services/FocusVisual.cs 里注册了全局类处理器，
      把任何漏设的控件的系统默认焦点样式替换成空模板，
      保证「应用内没有虚线」是硬保证，而不是靠逐个控件记得设置。
    -->

    <!-- ==================== 焦点视觉 ==================== -->

    <!-- 空模板：不画任何焦点框 -->
    <Style x:Key="NoFocusVisual" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 自绘实线焦点环：强调色 2px 圆角框 -->
    <Style x:Key="KeyboardFocusRing" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border Margin="-2"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 卡片 ==================== -->
    <!--
        卡片是全局复用的视觉单元：白底/深底 + 1px 边框 + 圆角 + 阴影。
        阴影资源 CardShadowEffect 放在主题令牌里 —— 深浅两套阴影浓度不同，
        放在这里写死会导致浅色主题下阴影过重。
    -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Effect" Value="{DynamicResource CardShadowEffect}" />
    </Style>

    <!-- 卡片内层（彩虹面板那种凹陷区） -->
    <Style x:Key="InnerPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardInnerBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!--
        ==================== 主题色胶囊 ====================

        【统一规则】
        凡是以「主题色」作背景、里面还要放文字的控件（版本号胶囊、
        状态标签之类），一律走这套组合：
            底 = AccentSubtleBrush（淡主题色，半透明）
            字 = TextPrimaryBrush（不受主题色影响的高对比度文本色）
        理由：实心强调色打底时，文字对比度全看用户挑了什么颜色 ——
        挑个亮黄，白字就糊成一片。淡主题色把底色压到可控区间，
        文字就能固定用「深色主题=白 / 浅色主题=黑」。

        【后续同类控件直接套这两个样式即可】
    -->
    <Style x:Key="AccentSubtlePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="AccentPillTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--
        ==================== 主题色胶囊里的可点文字 ====================

        【为什么用 Button 而不是 Hyperlink】
        WPF 的 Hyperlink 会在内容上强制加下划线，并把文字刷成系统链接色，
        这两样都改不掉：
          · TextDecorations 是 Hyperlink 自己写进内容的本地值，
            在内部 TextBlock 上设 TextDecorations="None" 也盖不住；
          · 颜色虽能用 TextElement.Foreground 接管，但下划线去不掉。
        而胶囊要的就是「干净的底 + 高对比度字」，
        所以改用透明 Button：外观完全由自己掌控，
        键盘可达性由 Button 原生提供（Hyperlink 本来也是）。
    -->
    <Style x:Key="PillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ==================== 托盘菜单项 ====================

        【为什么托盘菜单要自己画】
        Win32 的 CreatePopupMenu 走的是系统菜单渲染：
          · 在深色任务栏上仍是浅色米白气泡，与应用主题彻底割裂；
          · 字号、字体、行高都不受应用控制；
          · 想改深浅只能靠 uxtheme 的 undocumented API
            （SetPreferredAppMode / AllowDarkModeForWindow），
            而这两个在较新的 Windows 上已被移除 ——
            实测本机 uxtheme.dll 只导出 SetWindowTheme。
        所以菜单改成 WPF 自绘：外观完全跟随主题令牌，
        行为（定位、点击外部关闭、ESC 关闭）由 Popup 保证。
    -->
    <Style x:Key="TrayMenuItemStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <!--
                            ContentPresenter 的 HorizontalAlignment 决定 **child 在 Presenter 里怎么排**：
                              · Stretch → child 拉伸到 Presenter 宽度
                              · Left/Center/Right → child 按自己的 DesiredSize 宽度排

                            之前这里绑了 Button 的 HorizontalContentAlignment（=Left），
                            child 就被按 DesiredSize 宽度排列。
                            而 TextBlock 的 DesiredSize.Width 是按字体 advance 算的
                            （中文 13px × 4 字 = 52px），一旦实际字形墨迹略微超出
                            advance（Segoe UI Variable Text → 雅黑的回退链尤其明显），
                            最后一个字就被切掉右半边 ——
                            表现就是「显示窗口」缺半个「口」、「退出程序」缺半个「程」。

                            所以这里不设 HorizontalAlignment，保持默认 Stretch：
                            child 拉伸到可用宽度，文字在 TextBlock 内部自然左对齐，
                            既不裁切也不换行。
                        -->
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextMetaBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource BorderColorBrush}" />
    </Style>

    <!--
        ==================== 托盘菜单项文字 ====================

        【为什么文字要带右边距】
        ContentPresenter 会把 child 裁到自己的 bounds。
        而 child（TextBlock）的 DesiredSize.Width 是按字体 advance 算的，
        中文字体链（Segoe UI Variable Text → Segoe UI → 雅黑）在 fallback 时
        实际渲染出的墨迹宽度会略大于 advance 总和 ——
        于是宽度一旦恰好等于 advance 总和，最后一个字的右缘就被切掉。

        现象：「显示窗口」缺半个「口」、「退出程序」缺半个「程」；
        而同一行里的「禁用配置（预留）」是普通 TextBlock（宽度大于文字宽），
        一个字都没少。

        Padding 右侧留 8px 余量后，TextBlock 的 DesiredSize 比文字墨迹宽，
        ContentPresenter 裁不到字形 —— 且这与具体字体无关，换字体也不会复发。
    -->
    <Style x:Key="TrayMenuItemTextStyle" TargetType="TextBlock">
        <Setter Property="Padding" Value="0,0,8,0" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <!-- ==================== 分段控件（RadioButton 重写） ==================== -->
    <Style x:Key="SegmentRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <!-- 焦点指示：自绘实线环，替换系统点划线 -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="4"
                            Padding="16,6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：仅提亮文字，不加背景（与参考 HTML 一致） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>

                        <!--
                            选中：背景反白 + 文字加粗。

                            【注意这里没有 IsKeyboardFocused 的边框 Trigger】
                            焦点指示完全交给 FocusVisualStyle（KeyboardFocusRing）。
                            原因：IsKeyboardFocused 在**鼠标点击**后同样为 true，
                            若用它画框，鼠标点一下就会留下一个框 —— 这正是
                            之前「聚焦不正确」的来源。FocusVisualStyle 由 WPF
                            只在键盘导航时触发，行为与 Windows 原生一致。
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource WindowBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 彩虹滑块（Slider 重写） ==================== -->
    <Style x:Key="HueSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <!-- 滑块本身已有白色圆点作指示，不需要额外焦点框 -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Height="20">
                        <!--
                            彩虹轨道：7 色线性渐变。

                            【Margin 与 Thumb 行程对齐】
                            WPF 的 Slider 在两端各留半个 Thumb 宽度的余量
                            （Thumb 中心才能落在轨道端点），若渐变铺满整条，
                            就会出现「Value=0 时 Thumb 压在渐变中段」的错位。

                            这里给渐变加左右各 9px 的 Margin（= Thumb 18px 的一半），
                            使渐变区间与 Thumb 中心行程严格重合 ——
                            拖到最左时 Thumb 圆心正好落在纯红端，最右落在纯红端。

                            【为什么不要 BorderThickness】
                            之前轨道画了 1px 边框。Border 的圆角是「外圆角」，
                            1px 描边贴着它画会形成**内外两层半径**，
                            红端看上去像被切掉一个角（内外圆角不一致）。
                            纯渐变 + 单一 CornerRadius 不存在这个问题。
                        -->
                        <Border x:Name="TrackBorder"
                                Height="6"
                                Margin="9,0"
                                CornerRadius="3"
                                VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFFF0000" Offset="0.00" />
                                    <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                    <GradientStop Color="#FF00FF00" Offset="0.33" />
                                    <GradientStop Color="#FF00FFFF" Offset="0.50" />
                                    <GradientStop Color="#FF0000FF" Offset="0.67" />
                                    <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                    <GradientStop Color="#FFFF0000" Offset="1.00" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!--
                            Track 必须真实存在：Slider 的 Value → 像素映射由
                            Track 负责计算 Thumb 位置。没有 PART_Track，
                            Thumb 会固定在起点，拖动完全失效。
                        -->
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="18" Height="18" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbEllipse"
                                                     Width="18" Height="18"
                                                     Fill="White"
                                                     Stroke="White"
                                                     StrokeThickness="2">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.4" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbEllipse" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <media:ScaleTransform ScaleX="1.15" ScaleY="1.15" CenterX="9" CenterY="9" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 导航项 ==================== -->
    <Style x:Key="NavItemStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <!-- 焦点指示：自绘实线环，替换系统点划线 -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Root"
                                Height="40"
                                Margin="0,1"
                                CornerRadius="5"
                                Background="Transparent">
                            <ContentPresenter Margin="12,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>

                        <!--
                            选中态左侧强调色竖条。

                            【必须放在 Root 之后】
                            Grid 的子元素按声明顺序叠放，后声明的在上层。
                            Root 的背景（ItemSelectedBrush）在浅色主题下是
                            **不透明**的灰色（#D0D0D0），深色下是半透明白。
                            若 Indicator 在 Root 之前，浅色下会被不透明选中背景
                            完全盖住 —— 表现就是「浅色模式没有小竖条」。
                            放在之后即可保证两种主题下都压在上层可见。
                        -->
                        <Border x:Name="Indicator"
                                Width="3" Height="16"
                                HorizontalAlignment="Left"
                                CornerRadius="0,4,4,0"
                                Background="{DynamicResource AccentBrush}"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!--
                            刻意**没有** IsKeyboardFocused 的边框 Trigger ——
                            焦点指示全部交给 FocusVisualStyle（KeyboardFocusRing）。
                            原因见 SegmentRadioButtonStyle 里的说明。
                        -->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 窗口控制按钮 ==================== -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DangerBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 输入框 ==================== -->
    <!--
        自绘 TextBox 模板而不是用系统默认：
        默认模板在深色主题下会露出系统浅色边框与高对比焦点框，
        且默认模板不随 DynamicResource 变色。
    -->
    <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <!-- 输入框靠边框变色提示聚焦，不需要额外的焦点环 -->
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">
                        <!--
                            PART_ContentHost 必须是 ScrollViewer（WPF 的硬性要求）。

                            【为什么 VerticalAlignment 不能设 Center】
                            设了 Center 后，内容高度超过可用空间时会**向上溢出**
                            并被裁切 —— 表现就是文字只显示上半截。
                            改成 Stretch 让它撑满，行高不够时由外层 Border 自然增高，
                            文字永远完整。

                            高度由使用方决定（HEX 框用 Height="32"），
                            但字号大时需留足余量，因此这里把 MinHeight 也放开。
                        -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Stretch"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 滚动条 ==================== -->
    <!--
        系统默认 ScrollBar 在深色主题下是一根发白的粗条 —— 典型的「孤儿控件」：
        页面其余部分都跟着主题变了，只有它还是系统浅色。
        这里自绘一根细的、随主题变色的滚动条。
    -->
    <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd"
                            Margin="2"
                            Background="{DynamicResource BorderLightBrush}"
                            CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarLineButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBarLineButtonStyle}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 隐式样式：让全应用所有 ScrollBar 都用上面这根（否则单独每个页面设置容易漏） -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}" />

    <!--
        ==================== ToolTip（全局隐式样式）===================

        【为什么要重写】
        WPF 默认的 ToolTip 是 Aero 时代的产物：
          · 米黄/白底 + 深灰描边 + 一个系统小箭头（Path 三角）
          · 深色主题下这块浅色气泡极其刺眼
          · 字号与字体不跟随应用
        所以整块模板重写，做成与卡片同源的扁平浮层。

        【关键点】
        · 自定义 ControlTemplate 天然去掉了系统小箭头与默认边框；
        · HasDropShadow=False 去掉 Popup 的系统阴影，改用 Effect 里的轻阴影；
        · 隐式样式（无 x:Key）→ 全应用所有 ToolTip 自动生效；
        · Opened 时 0.1 秒淡入，避免浮层「啪」地弹出来。

        【命名说明】
        规范里写的 BorderBrush 在本工程并不存在 —— 边框色 token 叫
        BorderColorBrush（深色 #2D2D2D / 浅色 #E0E0E0），这里用的是它。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColorBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />

        <!-- 系统阴影（带小箭头的那个黑边）关掉，改用轻阴影 -->
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Effect" Value="{DynamicResource ToolTipShadowEffect}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Content"
                                          TextBlock.Foreground="{TemplateBinding Foreground}"
                                          TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                          TextBlock.FontSize="{TemplateBinding FontSize}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <!-- 出现时 0.1 秒淡入 -->
            <EventTrigger RoutedEvent="Opened">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.1" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
