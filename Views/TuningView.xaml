<UserControl x:Class="ZentwikThemeDemo.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZentwikThemeDemo.Converters"
             xmlns:vm="clr-namespace:ZentwikThemeDemo.ViewModels"
             xmlns:views="clr-namespace:ZentwikThemeDemo.Views"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <!--
      调校页（第一页）。

      【版式来源】
      参考 deepseek_html_20261102_c7adf0.html（调校页极简版）的结构：
        硬件概览卡（同步按钮 + 型号 + 应用）
        → SMU 硬件调校卡（逐核 CO 网格 + 最高加速频率）
        → 底部浮动保存条
      颜色与控件一律走工程自己的令牌与样式，不抄 HTML 的 CSS 值。

      【电源策略已移到第三页「电源」】
      电源策略走 Windows 电源计划接口，与 SMU 调校是两条不同的通路；
      混在一页会让「改 SMU」和「改系统电源」共用一个「应用」按钮。
      详见 Views/PowerView.xaml。

      【与 HTML 的刻意差异】
      逐核 CO 网格用 4 列而不是 8 列：
        内容区宽 864px、卡片内边距 48px → 可用 816px；
        8 列时每格仅剩 72px，放不下「− / 输入框 / +」三件套
        （按钮 28 + 输入框 + 按钮 28 加起来就要 70px 以上），
        HTML 那版在 1180px 窗口下其实已经超宽。4 列每格 194px，
        数字与核号都读得清。

      【方案切换走大窗】
      页头下方的 ProfileBar 是入口，真正的切换 / 重命名 / 删除在
      ProfileOverlay 模态大窗里 —— 三页共用同一份 ProfileSession 状态。
    -->

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:TuningViewModel />
    </UserControl.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- 底部留白：给浮动保存条让位，避免最后一行被压住 -->
            <StackPanel Margin="0,0,0,72">

                <!-- ==================== 页头 ==================== -->
                <TextBlock Text="调校"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="0,0,0,20" />

                <!-- 方案条（与进程页、电源页共用同一个大窗） -->
                <views:ProfileBar Margin="0,0,0,20" />

                <!-- ==================== 硬件概览 ==================== -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 左：同步按钮 + 型号 + SMU 状态 -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButtonStyle}"
                                    Command="{Binding RefreshCommand}"
                                    ToolTip="同步硬件状态：读回 SMU 与电源策略的当前值">
                                <Path Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8 M21 3v5h-5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="16" Height="16"
                                      Stretch="Uniform" />
                            </Button>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CpuName}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Margin="0,5,0,0"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding CpuCoreCount, Mode=OneWay}" />
                                    <Run Text=" 核处理器 · " />
                                    <Run Text="{Binding SmuStatusText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右：应用 -->
                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="88"
                                VerticalAlignment="Center"
                                Command="{Binding ApplyCommand}"
                                ToolTip="把当前值写入 SMU 并立即生效">
                            <TextBlock Text="应用" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== SMU 硬件调校 ==================== -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,0,20">
                    <StackPanel>

                        <StackPanel>
                            <TextBlock Text="SMU 硬件调校"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="通过系统管理单元直接改写处理器参数"
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource DividerStyle}" Margin="0,18,0,0" />

                        <!-- 逐核 CO -->
                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="核心电压偏移"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="（CO）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMetaBrush}"
                                           Margin="6,2,0,0"
                                           ToolTip="Curve Optimizer：逐核微调电压-频率曲线，范围 -50 ~ +50" />
                            </StackPanel>

                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding CoreMargins}"
                                          Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerPanelStyle}"
                                                Margin="0,0,10,10"
                                                Padding="12,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMetaBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,7" />

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0"
                                                            Style="{StaticResource StepperButtonStyle}"
                                                            Command="{Binding DecrementCommand}"
                                                            ToolTip="下调 1">
                                                        <TextBlock Text="&#x2212;" TextAlignment="Center" />
                                                    </Button>

                                                    <TextBox Grid.Column="1"
                                                             Style="{StaticResource NumberFieldStyle}"
                                                             Margin="5,0"
                                                             Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                             ToolTip="该核的 CO 偏移值" />

                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource StepperButtonStyle}"
                                                            Command="{Binding IncrementCommand}"
                                                            ToolTip="上调 1">
                                                        <TextBlock Text="&#x2B;" TextAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- 最高加速频率 -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="最高加速频率"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="（FMax）"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMetaBrush}"
                                           Margin="6,2,0,0"
                                           ToolTip="Max Frequency：处理器允许达到的最高频率，单位 MHz" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding StepFMaxDownCommand}"
                                        ToolTip="下调 10 MHz">
                                    <TextBlock Text="&#x2212;" TextAlignment="Center" />
                                </Button>

                                <TextBox Style="{StaticResource NumberFieldStyle}"
                                         Width="78"
                                         Margin="6,0"
                                         Text="{Binding FMaxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                         ToolTip="当前 FMax（MHz）" />

                                <Button Style="{StaticResource StepperButtonStyle}"
                                        Command="{Binding StepFMaxUpCommand}"
                                        ToolTip="上调 10 MHz">
                                    <TextBlock Text="&#x2B;" TextAlignment="Center" />
                                </Button>

                                <TextBlock Text="MHz"
                                           FontSize="12.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 浮动保存条 ==================== -->
        <!--
            只在「有未保存的改动」时出现（IsDirty 绑定）。
            贴在内容区右下角，不遮挡页面主体 —— 页面底部已预留 72px 让位。
        -->
        <Border HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,4,16"
                Padding="18,11"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Effect="{DynamicResource CardShadowEffect}"
                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="参数已修改"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <Button Style="{StaticResource GhostButtonStyle}"
                        MinWidth="62"
                        Command="{Binding DiscardCommand}"
                        ToolTip="放弃未保存的修改，回到上次读到的状态">
                    <TextBlock Text="放弃" TextAlignment="Center" />
                </Button>

                <Button Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="84"
                        Margin="8,0,0,0"
                        Command="{Binding SaveCommand}"
                        ToolTip="只写入方案文件，不改动硬件">
                    <TextBlock Text="保存方案" TextAlignment="Center" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
