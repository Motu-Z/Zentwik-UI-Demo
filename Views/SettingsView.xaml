<UserControl x:Class="ZentwikThemeDemo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZentwikThemeDemo.Converters"
             xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
             xmlns:vm="clr-namespace:ZentwikThemeDemo.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="杂项"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,32" />

            <!-- ==================== 外观设置卡片 ==================== -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="外观"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,24" />

                    <!-- 主题行 -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="主题"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsLightSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 7 A5,5 0 1 0 12 17 A5,5 0 1 0 12 7 M12 1 v2 M12 21 v2 M4.22 4.22 l1.42 1.42 M18.36 18.36 l1.42 1.42 M1 12 h2 M21 12 h2 M4.22 19.78 l1.42 -1.42 M18.36 5.64 l1.42 -1.42"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="浅色" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsDarkSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M21 12.79 A9,9 0 1 1 11.21 3 A7,7 0 0 0 21 12.79 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="深色" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsSystemSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4 3 H20 A2,2 0 0 1 22 5 V15 A2,2 0 0 1 20 17 H4 A2,2 0 0 1 2 15 V5 A2,2 0 0 1 4 3 Z M8 21 h8 M12 17 v4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="系统" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 色彩行 -->
                    <Grid>
                        <TextBlock Text="色彩"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="AccentMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsSystemAccentSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4 3 H20 A2,2 0 0 1 22 5 V15 A2,2 0 0 1 20 17 H4 A2,2 0 0 1 2 15 V5 A2,2 0 0 1 4 3 Z M8 21 h8 M12 17 v4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="系统" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="AccentMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsCustomAccentSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 22 C17.5228 22 22 17.5228 22 12 C22 6.4771 17.5228 2 12 2 C6.4771 2 2 6.4771 2 12 C2 17.5228 6.4771 22 12 22 Z M12 6 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M18 12 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M6 12 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M12 16 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="个性" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--
                        彩虹滑块面板：仅「个性」模式展开。

                        【为什么展开/收起由 Code-Behind 的 Storyboard 驱动】
                        高度动画要驱动的是外层容器的 Height，而 DataTrigger 里的
                        Storyboard 只能可靠地 TargetName 到模板内元素；
                        放在页面级 Style 里 TargetName 解析不可靠。
                        所以这里用具名元素 + View 层动画（详见 SettingsView.xaml.cs），
                        而「是否该展开」这个判断仍然来自 ViewModel 的
                        IsColorPanelVisible —— 状态判定没有下放到 View。
                    -->
                    <Grid x:Name="ColorPanelHost"
                          Margin="0,16,0,0"
                          Height="0"
                          Visibility="Collapsed"
                          ClipToBounds="True">
                        <Border x:Name="ColorPanelBody"
                                Style="{StaticResource InnerPanelStyle}"
                                Padding="20,16"
                                Opacity="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    颜色预览色块。

                                    【为什么是「实心圆角矩形」而不是带阴影的方块】
                                    之前用 DropShadowEffect，阴影按元素**外接矩形**计算，
                                    不感知 Border 的圆角 —— 圆角处残留直角暗块，
                                    就是截图里那个「阴角」。
                                    后来又试过「双层 Border 辉光」，但外层那圈
                                    半透明色块在浅色主题下反而像个脏边。

                                    现在按需求改为最干净的方案：
                                    一个实心圆角矩形，无阴影、无辉光、无边框。
                                    颜色本身就是信息，不需要额外的装饰来强调。
                                -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="8"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" />

                                <!-- 彩虹滑块 -->
                                <Slider Grid.Column="1"
                                        Margin="20,0"
                                        Style="{StaticResource HueSliderStyle}"
                                        Minimum="0" Maximum="360"
                                        Value="{Binding HueValue, Mode=TwoWay}"
                                        VerticalAlignment="Center" />

                                <!--
                                    HEX 输入框。

                                    【为什么不用等宽字体】
                                    实测（本机 13px）：等宽字体里 F 的横杠宽
                                    6~7px，几乎占满整个字宽 ——
                                    于是 "#FFFFFF" 六个 F 的横杠横向对齐连成一条线，
                                    看起来像被删除线划掉了。

                                    比例字体（Segoe UI）F 的字宽更窄，
                                    横杠之间有明显空隙，不再连成一线。
                                    颜色值本身是 6 位十六进制，比例字体下
                                    依然清晰易读，且不再有「被划掉」的错觉。
                                -->
                                <TextBox Grid.Column="2"
                                         Width="92" Height="34"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="OnHexLostFocus"
                                         KeyDown="OnHexKeyDown" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 关于卡片 ==================== -->
            <!--
                关于卡片：应用图标 + 名称 + 版本号胶囊 + 两行注释。

                版式参考 deepseek_html_20261103_4cc9b4.html：
                  · 顶部一行：图标 / Zentwik / 版本号胶囊
                  · 底部两行「// 注释」风格（等宽字体 + 灰色）
                差异：HTML 用了 flex-grow 撑开大片空白，
                这里改成固定紧凑间距 —— 空白太大在紧凑侧栏布局里显得空。

                版本号不硬编码 —— 读程序集元数据（SettingsViewModel.AppVersion）。
            -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,24">
                <StackPanel>
                    <!-- 顶部一行：图标 / Zentwik / 版本号胶囊 -->
                    <StackPanel Orientation="Horizontal">
                        <!--
                            新矢量图标（闪电 Z）。
                            透明背景、无底板 —— 所以不需要圆角。
                            几何取自 Zentwik-fill_opacity_0.45.xaml，
                            颜色由 AppThemeService 组装，跟随主题。
                        -->
                        <Image Source="{DynamicResource BrandLogoImage}"
                               Width="36" Height="48"
                               Stretch="Uniform"
                               RenderOptions.EdgeMode="Unspecified" />

                        <TextBlock Text="Zentwik"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!--
                            版本号胶囊。
                            点击跳转到项目的 GitHub 仓库。

                            配色走统一规则：底 = 淡主题色，字 = 高对比度文本色。
                            （不能直接用 AccentBrush 打底 —— 实心强调色上放文字，
                              对比度全看用户挑了什么强调色。）

                            用透明 Button 而不是 Hyperlink：Hyperlink 会在内容上
                            强制加下划线、刷系统链接色，两样都去不掉。
                        -->
                        <Border Style="{StaticResource AccentSubtlePillStyle}"
                                Margin="12,0,0,0">
                            <Button Style="{StaticResource PillButtonStyle}"
                                    Click="OnVersionPillClick"
                                    ToolTip="在浏览器中打开项目仓库">
                                <TextBlock Style="{StaticResource AccentPillTextStyle}"
                                           Text="{Binding AppVersion}" />
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- 底部两行注释 -->
                    <!--
                        与上方标题行之间留一个空行（20px ≈ 一行行高）。
                        字体用 AppCommentFontFamily 而不是 AppMonoFontFamily：
                        后者全是无中文字形的西文字体，中文会被回退成宋体（衬线），
                        与等宽的「//」割裂。详见 Tokens.Dark.xaml 的说明。
                    -->
                    <StackPanel Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="//"
                                       Margin="0,0,8,0"
                                       FontFamily="{DynamicResource AppCommentFontFamily}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMetaBrush}" />
                            <TextBlock Text="关上我身后的门，我走了。"
                                       FontFamily="{DynamicResource AppCommentFontFamily}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="//"
                                       Margin="0,0,8,0"
                                       FontFamily="{DynamicResource AppCommentFontFamily}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMetaBrush}" />
                            <TextBlock Text="ZMotu"
                                       FontFamily="{DynamicResource AppCommentFontFamily}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
