<UserControl x:Class="ZentwikThemeDemo.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZentwikThemeDemo.Converters"
             xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
             xmlns:vm="clr-namespace:ZentwikThemeDemo.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <!-- 页面标题 -->
            <TextBlock Text="杂项"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,32" />

            <!-- ==================== 外观设置卡片 ==================== -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="外观"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,24" />

                    <!-- 主题行 -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="主题"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsLightSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 7 A5,5 0 1 0 12 17 A5,5 0 1 0 12 7 M12 1 v2 M12 21 v2 M4.22 4.22 l1.42 1.42 M18.36 18.36 l1.42 1.42 M1 12 h2 M21 12 h2 M4.22 19.78 l1.42 -1.42 M18.36 5.64 l1.42 -1.42"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="浅色" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsDarkSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M21 12.79 A9,9 0 1 1 11.21 3 A7,7 0 0 0 21 12.79 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="深色" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="ThemeMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsSystemSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4 3 H20 A2,2 0 0 1 22 5 V15 A2,2 0 0 1 20 17 H4 A2,2 0 0 1 2 15 V5 A2,2 0 0 1 4 3 Z M8 21 h8 M12 17 v4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="系统" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 色彩行 -->
                    <Grid>
                        <TextBlock Text="色彩"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <Border HorizontalAlignment="Right"
                                Background="{DynamicResource ControlBgBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="AccentMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsSystemAccentSelected, Mode=TwoWay}"
                                             Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M4 3 H20 A2,2 0 0 1 22 5 V15 A2,2 0 0 1 20 17 H4 A2,2 0 0 1 2 15 V5 A2,2 0 0 1 4 3 Z M8 21 h8 M12 17 v4"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="系统" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="AccentMode"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             IsChecked="{Binding IsCustomAccentSelected, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M12 22 C17.5228 22 22 17.5228 22 12 C22 6.4771 17.5228 2 12 2 C6.4771 2 2 6.4771 2 12 C2 17.5228 6.4771 22 12 22 Z M12 6 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M18 12 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M6 12 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M12 16 m-2 0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="14"
                                              Stretch="Uniform" />
                                        <TextBlock Text="个性" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--
                        彩虹滑块面板：仅「个性」模式展开。

                        【为什么展开/收起由 Code-Behind 的 Storyboard 驱动】
                        高度动画要驱动的是外层容器的 Height，而 DataTrigger 里的
                        Storyboard 只能可靠地 TargetName 到模板内元素；
                        放在页面级 Style 里 TargetName 解析不可靠。
                        所以这里用具名元素 + View 层动画（详见 SettingsView.xaml.cs），
                        而「是否该展开」这个判断仍然来自 ViewModel 的
                        IsColorPanelVisible —— 状态判定没有下放到 View。
                    -->
                    <Grid x:Name="ColorPanelHost"
                          Margin="0,16,0,0"
                          Height="0"
                          Visibility="Collapsed"
                          ClipToBounds="True">
                        <Border x:Name="ColorPanelBody"
                                Style="{StaticResource InnerPanelStyle}"
                                Padding="20,16"
                                Opacity="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    颜色预览色块。

                                    【为什么不用 DropShadowEffect】
                                    WPF 的阴影是按元素**外接矩形**计算的，
                                    不感知 Border 的圆角 —— 圆角处会残留
                                    直角暗块，就是截图里那个「阴角」。

                                    这里改成参考 HTML 的做法：强调色辉光
                                    （accent 色的 8px 模糊扩散，无偏移）。

                                    实现方式：外层一个更大的圆角 Border 铺强调色
                                    并降低不透明度（充当扩散的辉光），
                                    内层实色方块盖在上面。
                                    纯几何、无滤镜，任何缩放下都不会有残留。
                                -->
                                    <Grid VerticalAlignment="Center">
                                        <!--
                                            辉光层：略大的圆角方块，模拟 8px 模糊扩散。

                                            圆角半径按尺寸**等比放大**（58 × 0.24 ≈ 14，
                                            对应内层 44 × 0.18 ≈ 8 的同一比例）——
                                            否则大尺寸配小圆角会看起来像个方块。
                                        -->
                                        <Border x:Name="SwatchGlow"
                                                Width="58" Height="58"
                                                CornerRadius="14"
                                                Background="{DynamicResource AccentBrush}"
                                                Opacity="0.22" />

                                        <!-- 实色层 -->
                                        <Border x:Name="SwatchFill"
                                                Width="44" Height="44"
                                                CornerRadius="8"
                                                Background="{DynamicResource AccentBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                    </Grid>

                                <!-- 彩虹滑块 -->
                                <Slider Grid.Column="1"
                                        Margin="20,0"
                                        Style="{StaticResource HueSliderStyle}"
                                        Minimum="0" Maximum="360"
                                        Value="{Binding HueValue, Mode=TwoWay}"
                                        VerticalAlignment="Center" />

                                <!--
                                    HEX 输入框。

                                    【为什么不用等宽字体】
                                    实测（本机 13px）：等宽字体里 F 的横杠宽
                                    6~7px，几乎占满整个字宽 ——
                                    于是 "#FFFFFF" 六个 F 的横杠横向对齐连成一条线，
                                    看起来像被删除线划掉了。

                                    比例字体（Segoe UI）F 的字宽更窄，
                                    横杠之间有明显空隙，不再连成一线。
                                    颜色值本身是 6 位十六进制，比例字体下
                                    依然清晰易读，且不再有「被划掉」的错觉。
                                -->
                                <TextBox Grid.Column="2"
                                         Width="92" Height="34"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         FontFamily="{DynamicResource AppFontFamily}"
                                         FontSize="13"
                                         FontWeight="SemiBold"
                                         TextAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         LostFocus="OnHexLostFocus"
                                         KeyDown="OnHexKeyDown" />
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== 关于卡片 ==================== -->
            <!--
                关于卡片：应用图标 + 名称 + 版本号 + 一句话简介 + 版权。

                版本号从程序集元数据读取（AppVersion 属性），
                不在这里硬编码 —— 版本随 csproj 变化时卡片自动跟随。
            -->
            <Border Style="{StaticResource CardStyle}"
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 应用图标：与侧栏同一枚自绘 Z 字形 -->
                    <Border Grid.Column="0"
                            Width="52" Height="52"
                            CornerRadius="10"
                            Background="{DynamicResource TextMetaBrush}"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Path Data="M4.8 0 H32 V8 L14.4 32 H0 V24 L17.6 8 H4.8 Z"
                              Fill="{DynamicResource BrandAccentBrush}"
                              Width="34" Height="34"
                              Stretch="Fill"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <TransformGroup>
                                    <media:SkewTransform AngleX="-15" AngleY="0" CenterX="17" CenterY="17" />
                                    <media:ScaleTransform ScaleX="1.05" ScaleY="1.05" CenterX="17" CenterY="17" />
                                </TransformGroup>
                            </Path.RenderTransform>
                        </Path>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <!-- 名称 + 版本号 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zentwik"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Margin="10,0,0,0"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="4">
                                <TextBlock Text="{Binding AppVersion}"
                                           FontSize="12"
                                           FontFamily="{DynamicResource AppMonoFontFamily}"
                                           Foreground="{DynamicResource AccentForegroundBrush}" />
                            </Border>
                        </StackPanel>

                        <!-- 一句话简介 -->
                        <TextBlock Text="Windows 端调校与自动化工具"
                                   Margin="0,8,0,0"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- 版权行 -->
                        <TextBlock Text="© 2026 Zentwik"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMetaBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
