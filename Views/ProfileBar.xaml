<UserControl x:Class="ZentwikThemeDemo.Views.ProfileBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ZentwikThemeDemo.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <!--
      页面顶部的方案条。

      【为什么做成独立控件】
      调校 / 进程 / 电源三页都要一个「切换方案」的入口，
      复制三遍 XAML 意味着以后改文案要改三处。
      这里抽成一个控件，三页各放一份即可。

      【它与大窗的关系】
      方案条只负责「打开大窗」；实际的切换、重命名、删除都在大窗里。
      两者共用 ProfileSession 单例，所以大窗里切完方案，
      方案条上的「当前方案」会立刻跟着变。

      【为什么 DataContext 用 ProfileSession 而不是页面 VM】
      方案状态跨页共享。页面 VM 负责页面自己的数据，
      方案条不该关心「当前是调校页还是电源页」。
    -->

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:StringEmptyToVisibilityConverter x:Key="StringEmptyToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}"
            Padding="16,12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左：标签 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="26" Height="26"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="13">
                    <Path Data="M3 12 h18 M7 8 h10 M7 16 h6"
                          Stroke="{DynamicResource TextPrimaryBrush}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="14" Height="14"
                          Stretch="Uniform" />
                </Border>

                <TextBlock Text="当前方案"
                           FontSize="12.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>

            <!-- 中：方案名 -->
            <TextBlock Grid.Column="1"
                       Margin="14,0,14,0"
                       VerticalAlignment="Center"
                       Text="{Binding CurrentName}"
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <!-- 右：打开大窗 -->
            <Button Grid.Column="2"
                    Style="{StaticResource GhostButtonStyle}"
                    MinWidth="96"
                    VerticalAlignment="Center"
                    Command="{Binding OpenOverlayCommand}"
                    ToolTip="切换、重命名或删除配置方案">
                <TextBlock Text="切换方案" TextAlignment="Center" />
            </Button>
        </Grid>
    </Border>
</UserControl>
