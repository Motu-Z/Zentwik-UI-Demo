<Window x:Class="ZentwikThemeDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
        xmlns:docs="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:ZentwikThemeDemo.ViewModels"
        xmlns:views="clr-namespace:ZentwikThemeDemo.Views"
        Title="Zentwik"
        Width="1180" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <!--
      无边框外壳。

      【为什么 AllowsTransparency="False"】
      AllowsTransparency=True 会让 WPF 退回 System DPI 感知，
      跨显示器时界面按位图拉伸、文字发虚，而且**没有任何 API 能在运行期补回来**。
      改用 WindowChrome 的 CornerRadius 做圆角：视觉等价，但保留 Per-Monitor V2 硬件缩放。

      【为什么 CaptionHeight="0"】
      WindowChrome 的 CaptionHeight 一旦大于 0，标题区就交给操作系统做原生拖拽，
      WPF 自己的 MouseLeftButtonDown 未必还触发 —— 那样「绑了事件」其实等于没绑。
      这里 CaptionHeight=0，拖拽完全由 Code-Behind 的 DragMove() 负责，行为确定可控。

      【窗口按钮必须带 IsHitTestVisibleInChrome】
      无边框窗口里命中测试默认被 WindowChrome 的 chrome 规则接管，
      不显式声明，三个窗口按钮就会「看得见点不动」。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="8"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧导航栏 ==================== -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 品牌区 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,20,12,24">
                    <!--
                        应用图标：矢量版 Zentwik 标志（闪电 Z）。
                        几何来自 SvgConverterTool 输出的
                        Zentwik-fill_opacity_0.45.xaml（VTracer 对位图的
                        像素级描摹，1024×1024 网格），详见 Themes/BrandLogo.xaml。

                        三层填充分别绑定品牌色的主色 / 中间调 / 高光，
                        因此图标会跟随强调色实时变化。
                        画刷本身是透明背景（无底板），这里不需要圆角。
                    -->
                    <Image Source="{DynamicResource BrandLogoImage}"
                           Width="26" Height="34"
                           Stretch="Uniform"
                           RenderOptions.EdgeMode="Unspecified" />

                    <!--
                        参考 HTML 的 letter-spacing: 0.5px 在 WPF 里没有对应属性：
                        System.Windows.Documents.Typography 只提供 Kerning（字距调整，
                        语义是"是否启用字距调整"而非"额外拉开多少"）。
                        16px Bold 下 0.5px 的视觉差异可忽略，这里用 Kerning 表达等效意图。
                    -->
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextOptions.TextFormattingMode="Ideal"
                               docs:Typography.Kerning="True">
                        <Run Text="Zen" /><Run Text="twik" Foreground="{DynamicResource BrandAccentBrush}" />
                    </TextBlock>
                </StackPanel>

                <!-- 导航菜单 -->
                <StackPanel x:Name="NavHost" Grid.Row="1" Margin="8,0">
                    <RadioButton x:Name="NavTuning"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Tuning"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4 21 v-7 m0 -4 V3 m8 18 v-9 m0 -4 V3 m8 18 v-5 m0 -4 V3 M1 14 h6 m2 -6 h6 m2 8 h6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="调校" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavProcess"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Process"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4 6 h16 M4 12 h10 M4 18 h16 M18 10 A2,2 0 1 0 18 14 A2,2 0 1 0 18 10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="进程" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavConfig"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Config"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M12 9 A3,3 0 1 0 12 15 A3,3 0 1 0 12 9 M19.4 15 a1.65,1.65 0 0 0 0.33 1.82 l0.06 0.06 a2,2 0 0 1 0 2.83 a2,2 0 0 1 -2.83 0 l-0.06 -0.06 a1.65,1.65 0 0 0 -1.82 -0.33 a1.65,1.65 0 0 0 -1 1.51 V21 a2,2 0 0 1 -2 2 a2,2 0 0 1 -2 -2 v-0.09 A1.65,1.65 0 0 0 9 19.4 a1.65,1.65 0 0 0 -1.82 0.33 l-0.06 0.06 a2,2 0 0 1 -2.83 0 a2,2 0 0 1 0 -2.83 l0.06 -0.06 a1.65,1.65 0 0 0 0.33 -1.82 a1.65,1.65 0 0 0 -1.51 -1 H3 a2,2 0 0 1 -2 -2 a2,2 0 0 1 2 -2 h0.09 A1.65,1.65 0 0 0 4.6 9 a1.65,1.65 0 0 0 -0.33 -1.82 l-0.06 -0.06 a2,2 0 0 1 0 -2.83 a2,2 0 0 1 2.83 0 l0.06 0.06 a1.65,1.65 0 0 0 1.82 0.33 H9 a1.65,1.65 0 0 0 1 -1.51 V3 a2,2 0 0 1 2 -2 a2,2 0 0 1 2 2 v0.09 a1.65,1.65 0 0 0 1 1.51 a1.65,1.65 0 0 0 1.82 -0.33 l0.06 -0.06 a2,2 0 0 1 2.83 0 a2,2 0 0 1 0 2.83 l-0.06 0.06 a1.65,1.65 0 0 0 -0.33 1.82 V9 a1.65,1.65 0 0 0 1.51 1 H21 a2,2 0 0 1 2 2 a2,2 0 0 1 -2 2 h-0.09 a1.65,1.65 0 0 0 -1.51 1 z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="配置" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 分隔线 -->
                    <Border Height="1" Margin="8,8" Background="{DynamicResource BorderColorBrush}" />

                    <RadioButton x:Name="NavMisc"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Misc"
                                 IsChecked="True"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M5 3 H19 A2,2 0 0 1 21 5 V19 A2,2 0 0 1 19 21 H5 A2,2 0 0 1 3 19 V5 A2,2 0 0 1 5 3 Z M3 9 h18 M9 21 V9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="杂项" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavBehavior"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Behavior"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M13 2 L3 14 h9 l-1 8 l10 -12 h-9 l1 -8 z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="行为" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <!-- 分隔线 -->
                    <Border Height="1" Margin="8,8" Background="{DynamicResource BorderColorBrush}" />

                    <RadioButton x:Name="NavLogs"
                                 Style="{StaticResource NavItemStyle}"
                                 GroupName="Nav"
                                 Tag="Logs"
                                 Checked="OnNavChecked">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M14 2 H6 a2,2 0 0 0 -2 2 v16 a2,2 0 0 0 2 2 h12 a2,2 0 0 0 2 -2 V8 z M14 2 v6 h6 M16 13 H8 M16 17 H8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="18" Height="18"
                                  Stretch="Uniform" />
                            <TextBlock Text="日志" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- 底部：版本号 -->
                <Border Grid.Row="2"
                        Height="56"
                        BorderBrush="{DynamicResource BorderColorBrush}"
                        BorderThickness="0,1,0,0">
                    <TextBlock x:Name="VersionText"
                               Margin="16,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMetaBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 右侧内容区 ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 业务视图宿主：Code-Behind 通过 ContentControl 路由切换 -->
            <ContentControl x:Name="ContentHost" Margin="48,52,48,48" />

            <!-- ==================== 窗口控制区 ==================== -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        Panel.ZIndex="10">
                <Button Style="{StaticResource WindowButtonStyle}"
                        Click="OnMinimizeClick"
                        ToolTip="最小化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0 5 h10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="MaxButton"
                        Style="{StaticResource WindowButtonStyle}"
                        Click="OnMaximizeClick"
                        ToolTip="最大化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path x:Name="MaxIcon"
                          Data="M1.5 0.5 H8.5 A1,1 0 0 1 9.5 1.5 V8.5 A1,1 0 0 1 8.5 9.5 H1.5 A1,1 0 0 1 0.5 8.5 V1.5 A1,1 0 0 1 1.5 0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource WindowCloseButtonStyle}"
                        Click="OnCloseClick"
                        ToolTip="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M0.5 0.5 l9 9 M9.5 0.5 l-9 9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="10" Height="10"
                          Stretch="Uniform" />
                </Button>
            </StackPanel>

            <!--
                拖拽区：覆盖内容区顶部一条。
                窗口控制按钮 Panel.ZIndex=10 渲染在上层，命中测试先命中它们，
                所以本条带不会挡住按钮；其余区域用于拖动窗口。
            -->
            <Border Height="44"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    MouseLeftButtonDown="OnDragAreaMouseDown" />
        </Grid>
    </Grid>
</Window>
